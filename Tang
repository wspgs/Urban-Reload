---Remove the esp objects of a player.
---@param player Player
local function removeEspObject(player)
	local object = espObjects[player]
	if not object then
		return
	end

	object.tracer:Destroy()
	object.box:Destroy()
	object.healthBack:Destroy()
	object.label:Destroy()
	espObjects[player] = nil
