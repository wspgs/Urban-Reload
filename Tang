---Cleanup everything this execution created.
function TangHub.detach()
	TangHub.alive = false

	for _, connection in ipairs(TangHub.connections) do
		connection:Disconnect()
	end

	if fovGui then
		fovGui:Destroy()
	end

	if espGui then
		espGui:Destroy()
	end

	if window then
		window:destroy()
	end
end

---Load the ui, install hooks and start the loop.
local function initializeScript()
	-- Skip the default menu, we build our own.
	getgenv().TangHubLibraryOnly = true

	local body = fetch(UI_URL)
	if not body then
		return warn("load failed")
	end

	local chunk, compileError = loadstring(body)
	if not chunk then
		return warn("compile error: " .. tostring(compileError))
	end

	local success, Library = pcall(chunk)
	if not success then
		return warn("run error: " .. tostring(Library))
	end

	clientHitboxes = loadGameModule("ClientHitboxes")
	hitboxModel = loadGameModule("HitboxModel")
	clientState = loadGameModule("ClientState")
	clientConfig = loadGameModule("Config")

	createFovCircle()
	espGui = createGui("TangEsp", false)
	buildMenu(Library)
	installHook()
	local antiKickOk = installAntiKick()

	window:notify({
		Title = "กันเตะ",
		Text = antiKickOk and "ติดตั้งกันเตะฝั่งไคลเอนต์แล้ว" or "ติดตั้งบางส่วน ใช้ได้เฉพาะ namecall",
	})

	window:notify({
		Title = "Hitbox",
		Text = clientHitboxes and "พบ Hitbox ของเกม ล็อกตรงจุดที่เซิร์ฟเช็ค" or "ไม่พบ Hitbox ใช้ตัวละครแทน",
	})

	table.insert(TangHub.connections, runService.RenderStepped:Connect(onRenderStep))
	table.insert(TangHub.connections, playersService.PlayerRemoving:Connect(removeEspObject))
end

---Called when initialization errors.
---@param errorMessage string
local function onInitializeError(errorMessage)
	warn("[TANG HUB] failed to initialize.")
	warn(errorMessage)
	warn(debug.traceback())
	TangHub.detach()
end

xpcall(initializeScript, onInitializeError)
