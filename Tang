---Hide every esp element of an object.
local function hideEspObject(object)
	object.tracer.Visible = false
	object.box.Visible = false
	object.healthBack.Visible = false
	object.label.Visible = false
end

---Update the esp for every player.
local function updateEsp()
	-- Tracers start from the top center of the screen.
	local origin = Vector2.new(espGui.AbsoluteSize.X / 2, 0)
	local cameraPosition = currentCamera.CFrame.Position

	for _, player in ipairs(playersService:GetPlayers()) do
		if player == localPlayer then
			continue
		end

		local object = espObjects[player]
		if not object then
			createEspObject(player)
			object = espObjects[player]
		end

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not (state.espEnabled and root and humanoid and humanoid.Health > 0) then
			hideEspObject(object)
			continue
		end

		local distance = (root.Position - cameraPosition).Magnitude
		if distance > state.espDistance then
			hideEspObject(object)
			continue
		end

		local screenPosition, onScreen = currentCamera:WorldToScreenPoint(root.Position)
		if not onScreen then
			hideEspObject(object)
			continue
		end

		local top = currentCamera:WorldToScreenPoint(root.Position + Vector3.new(0, 2.8, 0))
		local bottom = currentCamera:WorldToScreenPoint(root.Position - Vector3.new(0, 3.2, 0))
		local height = math.abs(bottom.Y - top.Y)
		local width = height * 0.55
		local centerY = (top.Y + bottom.Y) / 2
		local target = Vector2.new(screenPosition.X, screenPosition.Y)

		local tracer = object.tracer
		tracer.Visible = state.espTracers
		if state.espTracers then
			local delta = target - origin
			tracer.BackgroundColor3 = state.espColor
			tracer.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
			tracer.Position = UDim2.fromOffset((origin.X + target.X) / 2, (origin.Y + target.Y) / 2)
			tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
		end

		local box = object.box
		box.Visible = state.espBoxes
		if state.espBoxes then
			object.stroke.Color = state.espColor
			box.Size = UDim2.fromOffset(width, height)
			box.Position = UDim2.fromOffset(target.X, centerY)
		end

		-- Green health bar on the left side of the character.
		local healthBack = object.healthBack
		healthBack.Visible = state.espHealth
		if state.espHealth then
			local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
			healthBack.Size = UDim2.fromOffset(4, height)
			healthBack.Position = UDim2.fromOffset(target.X - width / 2 - 6, centerY)
			object.healthFill.Size = UDim2.fromScale(1, ratio)
		end

		local label = object.label
		label.Visible = state.espNames
		if state.espNames then
			label.Text = string.format(
				"%s [%dm] %d HP",
				player.DisplayName,
				math.floor(distance),
				math.floor(humanoid.Health)
			)
			label.Position = UDim2.fromOffset(target.X, math.min(top.Y, bottom.Y) - 2)
		end
	end
end

---Find a heal tool by item name in the character or backpack.
---@param itemName string
---@return Tool?
local function findItemTool(itemName)
	local wanted = string.lower(itemName)
	local backpack = localPlayer:FindFirstChildOfClass("Backpack")

	for _, container in ipairs({ localPlayer.Character, backpack }) do
		if not container then
			continue
		end

		for _, tool in ipairs(container:GetChildren()) do
			local item = tool:IsA("Tool") and tool:GetAttribute("Item")
			if item and (string.lower(tostring(item)) == wanted or string.lower(tool.Name) == wanted) then
				return tool
			end
		end
	end

	return nil
end

---Equip a heal tool and use it right away, then give the old tool back.
---The game's server still runs its own timer for the effect.
---@param itemName string
local function useHealItem(itemName)
	if healBusy then
		return
	end

	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	if clientState and clientState.HealItem then
		return
	end

	local tool = findItemTool(itemName)
	if not tool then
		return window:notify({ Title = "GOD", Text = "ไม่มี " .. itemName .. " ในกระเป๋า" })
	end

	healBusy = true

	local previous = character:FindFirstChildOfClass("Tool")
	if tool.Parent ~= character then
		humanoid:EquipTool(tool)

		local waited = 0
		while tool.Parent ~= character and waited < 1 do
			waited = waited + task.wait(0.03)
		end
	end

	local duration = 3
	if tool.Parent == character then
		task.wait(0.05)
		tool:Activate()

		local item = clientConfig and clientConfig.Heal and clientConfig.Heal.Items[tool:GetAttribute("Item")]
		duration = item and item.Time or duration
		task.wait(duration + 0.3)
	end

	if previous and previous ~= tool and previous.Parent == localPlayer:FindFirstChildOfClass("Backpack") then
		humanoid:EquipTool(previous)
	end

	healBusy = false
end

---Use heal items automatically when health or armor is low.
local function updateAutoHeal()
	if not (state.autoHeal or state.autoArmor) or healBusy then
		return
	end

	local now = os.clock()
	if now - lastAutoHeal < 0.25 then
		return
	end
	lastAutoHeal = now

	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.SeatPart then
		return
	end

	local percent = humanoid.Health / humanoid.MaxHealth * 100
	if state.autoHeal and percent < state.healPercent then
		return task.spawn(useHealItem, state.healItem)
	end

	if state.autoArmor and (character:GetAttribute("Armor") or 0) <= 0 then
		task.spawn(useHealItem, "Kevlar")
	end
end

---Change the name shown above our own head. Only we see it, the server keeps the real name.
---@param restore boolean
local function applyOverheadName(restore)
	local character = localPlayer.Character
	if not character then
		return
	end

	local text = restore and localPlayer.DisplayName or state.nameText
	if text == "" then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.DisplayName ~= text then
		humanoid.DisplayName = text
	end

	-- Custom name tags made by the game.
	for _, descendant in ipairs(character:GetDescendants()) do
		if not descendant:IsA("TextLabel") or not descendant:FindFirstAncestorOfClass("BillboardGui") then
			continue
		end

		local current = descendant.Text
		if current == localPlayer.DisplayName or current == localPlayer.Name or current == lastNameText then
			descendant.Text = text
		end
	end

	lastNameText = text
end

---Per frame update: reroll shot, refresh target, move fov circle, draw esp.
local function onRenderStep()
	currentCamera = workspace.CurrentCamera

	local now = os.clock()
	if now - lastRoll >= ROLL_INTERVAL then
		lastRoll = now
		state.redirect = math.random(1, 100) <= state.hitChance
		rolledHead = math.random(1, 2) == 1
	end

	updateAim()
	updateEsp()

	updateAutoHeal()

	if state.nameEnabled and now - lastNameApply >= 1 then
		lastNameApply = now
		applyOverheadName(false)
	end

	-- Stamina lives in the game's client state, keep it full.
	if state.infiniteStamina and clientState then
		pcall(function()
			clientState.Stamina = clientState.StaminaMax or 150
			clientState.Exhausted = false
		end)
	end

	fovCircle.Visible = state.enabled and state.showFov
	fovCircle.Size = UDim2.fromOffset(state.fov * 2, state.fov * 2)

	local mousePosition = userInputService:GetMouseLocation()
	fovCircle.Position = UDim2.fromOffset(mousePosition.X, mousePosition.Y)
end

---Install the namecall hook. Redirects bullet raycasts only, the game sends its own remotes.
local function installHook()
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()

		if not TangHub.alive or checkcaller() then
			return oldNamecall(self, ...)
		end

		if state.antiKick and self == localPlayer and (method == "Kick" or method == "Destroy" or method == "Remove") then
			kickBlocked = kickBlocked + 1
			return
		end

		if not (state.enabled and state.redirect and aimPart) then
			return oldNamecall(self, ...)
		end

		-- Only touch bullets while a weapon is equipped.
		if clientState and clientState.Equipped ~= true then
			return oldNamecall(self, ...)
		end

		if state.rayMode and (method == "ViewportPointToRay" or method == "ScreenPointToRay") and self == currentCamera then
			local aimPosition = getAimPosition()
			local ray = oldNamecall(self, ...)
			if not aimPosition then
				return ray
			end

			local offset = aimPosition - ray.Origin
			if offset.Magnitude < 0.01 then
				return ray
			end

			-- Keep the ray long enough to reach far targets.
			local length = math.max(ray.Direction.Magnitude, offset.Magnitude + RAY_EXTRA_LENGTH)
			return Ray.new(ray.Origin, offset.Unit * length)
		end

		if state.raycastMode and method == "Raycast" and self == workspace then
			local origin, direction = ...
			if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
				return oldNamecall(self, ...)
			end

			if direction.Magnitude < RAYCAST_MIN_LENGTH then
				return oldNamecall(self, ...)
			end

			if (origin - currentCamera.CFrame.Position).Magnitude > RAYCAST_MAX_ORIGIN_OFFSET then
				return oldNamecall(self, ...)
			end

			local aimPosition = getAimPosition()
			if not aimPosition then
				return oldNamecall(self, ...)
			end

			local offset = aimPosition - origin
			if offset.Magnitude < 0.01 then
				return oldNamecall(self, ...)
			end

			-- Stretch the ray so far targets are still reached.
			local length = math.max(direction.Magnitude, offset.Magnitude + RAY_EXTRA_LENGTH)
			return oldNamecall(self, origin, offset.Unit * length, select(3, ...))
		end

		return oldNamecall(self, ...)
	end))
end

---Block client side kicks, both the colon form and the direct call form.
local function installAntiKick()
	local kickFunction = localPlayer.Kick
	local destroyFunction = localPlayer.Destroy

	local originalKick
	local kickOk = pcall(function()
		originalKick = hookfunction(kickFunction, newcclosure(function(player, ...)
			if TangHub.alive and state.antiKick and player == localPlayer then
				kickBlocked = kickBlocked + 1
				return
			end
			return originalKick(player, ...)
		end))
	end)

	local originalDestroy
	local destroyOk = pcall(function()
		originalDestroy = hookfunction(destroyFunction, newcclosure(function(player, ...)
			if TangHub.alive and state.antiKick and player == localPlayer then
				kickBlocked = kickBlocked + 1
				return
			end
			return originalDestroy(player, ...)
		end))
	end)

	return kickOk and destroyOk
end

