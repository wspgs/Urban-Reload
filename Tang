---Fetch a url with the custom request function.
---@param url string
---@return string?
local function fetch(url)
	local success, response = pcall(request, { Url = url, Method = "GET" })
	if not success or not response or response.StatusCode ~= 200 then
		return nil
	end
	return response.Body
end

---Outermost vehicle model of a seat.
---@param seat BasePart
---@return Model?
local function getVehicleModel(seat)
	local model = seat:FindFirstAncestorOfClass("Model")
	while model and model.Parent and model.Parent:IsA("Model") do
		model = model.Parent
	end
	return model
end

---Require a game module with a low identity so our environment does not leak.
---@param name string
---@return table?
local function loadGameModule(name)
	local weapons = replicatedStorage:FindFirstChild("Weapons")
	local moduleScript = weapons and weapons:FindFirstChild(name)
	if not moduleScript then
		return nil
	end

	local previous = getthreadidentity()
	setthreadidentity(2)
	local success, result = pcall(require, moduleScript)
	setthreadidentity(previous)

	return success and result or nil
end

---Find the server-side hitbox part the game really shoots at.
---@param character Model
---@param wantHead boolean
---@return BasePart?
local function getHitboxPart(character, wantHead)
	if not (clientHitboxes and clientHitboxes.folders and clientHitboxes.parts) then
		return nil
	end

	local folder = clientHitboxes.folders[character]
	if not folder then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local best, bestScore = nil, math.huge

	for _, part in ipairs(folder:GetDescendants()) do
		if not part:IsA("BasePart") then
			continue
		end

		local info = clientHitboxes.parts[part]
		if not info then
			continue
		end

		local isHead = hitboxModel and hitboxModel.HEAD and hitboxModel.HEAD[info.name] == true
		if wantHead then
			if isHead then
				return part
			end
		elseif not isHead then
			local score = root and (part.Position - root.Position).Magnitude or 0
			if score < bestScore then
				best, bestScore = part, score
			end
		end
	end

	return best
end

---Is the position visible from the camera, same filter the bullets use.
---@param position Vector3
---@param character Model
---@param humanoid Humanoid
---@return boolean
local function isVisible(position, character, humanoid)
	local filter = { character }
	local fxFolder = workspace:FindFirstChild("FX")
	if fxFolder then
		table.insert(filter, fxFolder)
	end

	if clientHitboxes and clientHitboxes.folders then
		local targetFolder = clientHitboxes.folders[character]
		local ownFolder = localPlayer.Character and clientHitboxes.folders[localPlayer.Character]
		if targetFolder then
			table.insert(filter, targetFolder)
		end
		if ownFolder then
			table.insert(filter, ownFolder)
		end
	end

	if localPlayer.Character then
		table.insert(filter, localPlayer.Character)
	end

	-- Drivers sit behind the car body, ignore the vehicle.
	local seat = humanoid.SeatPart
	if seat then
		local vehicle = getVehicleModel(seat)
		if vehicle then
			table.insert(filter, vehicle)
		end
	end

	local origin = currentCamera.CFrame.Position
	local direction = position - origin

	-- Bullets pass through glass.
	for _ = 1, 6 do
		visibilityParams.FilterDescendantsInstances = filter

		local result = workspace:Raycast(origin, direction, visibilityParams)
		if not result then
			return true
		end

		if result.Instance.Name:sub(1, 6) ~= "Glass_" then
			return false
		end

		table.insert(filter, result.Instance)
	end

	return false
end

---Pick the part to aim at on a character. Prefers the hitbox the server checks.
---@param character Model
---@return BasePart?, boolean
local function pickPart(character)
	local wantHead = state.targetMode == "หัว" or (state.targetMode == "สุ่ม" and rolledHead)

	local hitbox = getHitboxPart(character, wantHead) or getHitboxPart(character, not wantHead)
	if hitbox then
		return hitbox, true
	end

	if wantHead then
		local head = character:FindFirstChild("Head")
		if head then
			return head, false
		end
	end

	return character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart"),
		false
end

---Lead time in seconds used to predict moving targets.
---@return number
local function getLeadTime()
	if state.autoPredict then
		local success, ping = pcall(function()
			return localPlayer:GetNetworkPing()
		end)
		return (success and ping or 0) + 0.03
	end

	return state.prediction / 1000
end

---Current aim position, read live so it matches the hitbox at the moment of the shot.
---@return Vector3?
local function getAimPosition()
	if not aimPart or not aimPart.Parent then
		return nil
	end

	local position = aimPart.Position
	local lead = getLeadTime()

	-- Lead by the root velocity so running targets are still hit.
	if lead > 0 and aimRoot and aimRoot.Parent then
		position = position + aimRoot.AssemblyLinearVelocity * lead
	end

	return position
end

---Check if a player is a valid target and return its aim part.
---@param player Player
---@param limit number
---@param mousePosition Vector2
---@param cameraCFrame CFrame
---@return BasePart?, boolean, number, BasePart?
local function evaluateTarget(player, limit, mousePosition, cameraCFrame)
	local character = player.Character
	if not character then
		return nil, false, 0, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root and humanoid.Health > 0) then
		return nil, false, 0, nil
	end

	if humanoid.SeatPart and not state.targetSeated then
		return nil, false, 0, nil
	end

	-- Spawn shield targets cannot be damaged.
	if character:FindFirstChildOfClass("ForceField") then
		return nil, false, 0, nil
	end

	local part, isHitbox = pickPart(character)
	part = part or root

	local screenPosition, onScreen = currentCamera:WorldToViewportPoint(part.Position)
	if not onScreen then
		return nil, false, 0, nil
	end

	local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - mousePosition).Magnitude
	if distance >= limit then
		return nil, false, 0, nil
	end

	-- 180 means no angle limit, so far targets still lock.
	if state.maxAngle < 180 then
		local toPart = (part.Position - cameraCFrame.Position).Unit
		local angle = math.deg(math.acos(math.clamp(cameraCFrame.LookVector:Dot(toPart), -1, 1)))
		if angle > state.maxAngle then
			return nil, false, 0, nil
		end
	end

	if state.wallCheck and not isVisible(part.Position, character, humanoid) then
		return nil, false, 0, nil
	end

	return part, isHitbox, distance, root
end

---Find the player closest to the cursor inside the fov and cache the aim part.
---The current target stays locked while it runs, so it is not dropped at the fov edge.
local function updateAim()
	aimPart = nil

	if not state.enabled then
		lockedPlayer = nil
		return
	end

	local mousePosition = userInputService:GetMouseLocation()
	local cameraCFrame = currentCamera.CFrame

	-- Keep the locked target while it is still valid inside a wider fov.
	if lockedPlayer and lockedPlayer.Parent then
		local part, isHitbox, _, root =
			evaluateTarget(lockedPlayer, state.fov * STICKY_FOV_SCALE, mousePosition, cameraCFrame)
		if part then
			aimPart, aimIsHitbox, aimRoot = part, isHitbox, root
			return
		end
	end

	lockedPlayer = nil

	local bestDistance = state.fov
	local bestPlayer, bestPart, bestIsHitbox, bestRoot = nil, nil, false, nil

	for _, player in ipairs(playersService:GetPlayers()) do
		if player == localPlayer then
			continue
		end

		local part, isHitbox, distance, root = evaluateTarget(player, bestDistance, mousePosition, cameraCFrame)
		if not part then
			continue
		end

		bestDistance = distance
		bestPlayer = player
		bestPart = part
		bestIsHitbox = isHitbox
		bestRoot = root
	end

	lockedPlayer = bestPlayer
	aimPart, aimIsHitbox, aimRoot = bestPart, bestIsHitbox, bestRoot
end

---Create a gui in the hidden container.
---@param name string
---@param ignoreInset boolean
---@return ScreenGui
local function createGui(name, ignoreInset)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.IgnoreGuiInset = ignoreInset
	gui.ResetOnSpawn = false
